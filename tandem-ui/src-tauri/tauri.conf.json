{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "identifier": "com.tandem.network.aggregator",
  "productName": "Tandem",
  "version": "1.0.0",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../../bin/*"],
    "windows": {
      "wix": {},
      "nsis": {}
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Tandem",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": false,
      "sidecar": true,
      "scope": []
    }
  }
}
